# Copy this file to .env and fill in your keys.
# Environment variables override config/config.yaml and config/secrets.yaml.

# --- AI Gateway secrets ---
GROQ_API_KEY=your_groq_api_key_here
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=

# --- Database (overrides mongodb.uri) ---
MONGO_URI=mongodb://localhost:27017

# --- Server ---
# SERVER_PORT=8000

# --- CLI target (cmd/lumina) ---
# LUMINA_SERVER_URL=http://localhost:8000

# --- OpenTelemetry ---
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_SERVICE_NAME=lumina-plane-server
