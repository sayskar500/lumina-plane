{
  "uid": "lumina-ai-gateway",
  "title": "Lumina-Plane AI Gateway Dashboard",
  "description": "Real-time monitoring of AI Gateway performance and cost",
  "tags": ["lumina-plane"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Token Consumption",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "lumina-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "colorMode": "value", "graphMode": "area" },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(lumina_tokens_used_total)" }]
    },
    {
      "id": 2,
      "title": "Error Rate %",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "lumina-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(lumina_ai_requests_total{status=\"error\"}[5m])) / sum(rate(lumina_ai_requests_total[5m])) * 100" }]
    },
    {
      "id": 3,
      "title": "P99 Request Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "lumina-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(lumina_ai_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 4,
      "title": "Requests per Second (by Model)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "lumina-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum by (model) (rate(lumina_ai_requests_total[1m]))" }]
    }
  ]
}
