{
  "title": "Lumina-Plane AI Gateway Dashboard",
  "description": "Real-time monitoring of AI Gateway performance and cost",
  "panels": [
    {
      "title": "Total Token Consumption",
      "type": "stat",
      "targets": [{ "expr": "sum(lumina_tokens_used_total)" }]
    },
    {
      "title": "P99 Request Latency",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(lumina_ai_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "title": "Requests per Second (by Model)",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (model) (rate(lumina_ai_requests_total[1m]))" }]
    },
    {
      "title": "Error Rate %",
      "type": "gauge",
      "targets": [{ "expr": "sum(rate(lumina_ai_requests_total{status=\"error\"}[5m])) / sum(rate(lumina_ai_requests_total[5m])) * 100" }]
    }
  ]
}
