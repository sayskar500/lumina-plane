# Copy to terraform.tfvars (gitignored) or export TF_VAR_groq_api_key.
# The Groq key is shared with the Render deployment (terraform/terraform.tfvars).
groq_api_key = "gsk_your_actual_key_here"

# Optional overrides:
# location                = "centralindia"
