FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o server ./cmd/server/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/server ./server
# Bake in the default config; secrets must come from the environment or a
# mounted config/secrets.yaml, never from the image itself.
COPY config/config.yaml ./config/config.yaml
EXPOSE 8000
CMD ["./server"]
